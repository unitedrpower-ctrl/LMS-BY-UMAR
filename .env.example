# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL & PUBLIC_URL: The URL where this applet is hosted.
# Used for self-referential invitation links and OAuth callbacks.
APP_URL="https://your-live-domain.com"
PUBLIC_URL="https://your-live-domain.com"

# Brevo HTTP Email API Configuration (Port 443 REST API Dispatch)
BREVO_API_KEY="xkeysib-your_brevo_api_key"
SENDER_EMAIL="notifications@yourdomain.com"

# SMTP / Nodemailer Fallback Dispatch Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="LMS by Umar <notifications@yourdomain.com>"

# Cloudinary Storage Configuration for Worker Photos & Document Vault
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Master Administrator & Platform Owner Secrets
MASTER_PASSWORD="your-strong-master-password"
OWNER_PASSCODE="your-strong-owner-passcode"
DEFAULT_INVITE_PASSWORD="your-default-invite-password"

# Client-Side Exposed Environment Variables (VITE_ prefix required for Vite bundles)
VITE_MASTER_PASSWORD="your-strong-master-password"
VITE_OWNER_PASSCODE="your-strong-owner-passcode"

# Database Configuration (PostgreSQL / Neon / SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/lms_db"
JWT_SECRET="your-jwt-signing-secret"
